{
  "name": "beer-die-league-web",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "workspaces": [
    "packages/core",
    "apps/api",
    "apps/app"
  ],
  "scripts": {
    "dev": "node scripts/dev.ts",
    "test": "vitest run --project core --project app --project api",
    "test:stack": "vitest run --project stack",
    "e2e": "node scripts/e2e.ts",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -p . && tsc -p e2e && npm run typecheck --workspaces",
    "build": "npm run build -w apps/app",
    "stack": "node scripts/stack.ts",
    "verify": "npm run stack -- build && npm run stack -- up -d --wait db mailpit migrate api worker web && npm run typecheck && npm run lint && npm test && npm run test:stack && npm run e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild": false
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": ">=0.25.0"
    },
    "xcode": {
      "uuid": "^11.1.1"
    }
  }
}
