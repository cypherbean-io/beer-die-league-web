# Copy to .env and fill in. Never commit .env.
# For local dev and tests, scripts/local-env.ts already supplies these defaults, so a
# .env is only needed to override them.

# Postgres connection. Dev/test default: the compose `db` service (trust auth, loopback only).
DATABASE_URL=postgres://postgres@127.0.0.1:5432/beerdie

# At least 32 characters. Keys the sign-in-code HMACs, the rate-limit key HMACs, and the
# encryption of codes held in the email outbox. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Rotating it invalidates outstanding sign-in codes and queued code emails; sessions survive.
AUTH_SECRET=

# The web app's origin. Cookie-authenticated writes must send a matching Origin header.
APP_ORIGIN=http://localhost:8081

# Outbound mail. Dev default: Mailpit on loopback.
# A remote server must use TLS: smtps://…, or smtp://…?requireTLS=true.
# Use ignoreTLS=true only for a plaintext server you trust, such as Mailpit inside Compose.
# Production example: smtps://USER:PASSWORD@smtp.example.com:465
SMTP_URL=smtp://127.0.0.1:1025

# From header for all outbound mail.
MAIL_FROM=Beer Die League <no-reply@beerdie.localhost>
